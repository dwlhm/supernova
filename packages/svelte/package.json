{
  "name": "@dwlhm/ui-svelte",
  "version": "1.0.1",
  "description": "Svelte UI components for dwlhm Design System",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "svelte": "./src/index.ts",
