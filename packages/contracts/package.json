{
  "name": "@supernova/contracts",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate:ts": "openapi-typescript openapi.yaml -o src/schema.ts",
