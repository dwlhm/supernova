{
  "name": "@dwlhm/ui-vue2",
  "version": "1.0.5",
  "description": "Vue 2 UI components for dwlhm Design System (Webpack 4 compatible)",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./*.vue": "./src/*.vue"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "vite build"
  },
  "peerDependencies": {
    "vue": "^2.6.14 || ^2.7.0"
  },
  "dependencies": {
    "@dwlhm/design-tokens": "^1.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue": "^2.7.16"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
