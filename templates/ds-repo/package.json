{
  "name": "@supernova-ds/core",
  "version": "0.1.0",
  "description": "Multi-framework Design System generated by Supernova",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./tokens": "./dist/tokens/tokens.js",
    "./tokens.css": "./dist/tokens/tokens.css",
    "./theme.css": "./dist/tokens/theme.css",
    "./react": "./dist/react/index.js",
    "./vue3": "./dist/vue3/index.js",
    "./svelte": "./dist/svelte/index.js",
    "./vue2": "./dist/vue2/index.js",
    "./angular": "./dist/angular/index.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm compile && tsc",
    "compile": "node scripts/compile.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.js",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@supernova/mitosis-compiler": "workspace:*",
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  }
}
