{
  "name": "@komerce-design/example-react",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone React 19 + Tailwind CSS v4 example application showcasing all 36 Komerce Design System component families and headless controllers",
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/compile-library.mjs",
    "dev": "vite",
