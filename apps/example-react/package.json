    "build": "vite build",
    "preview": "vite preview",
    "pretypecheck": "node ../../scripts/compile-library.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/example-react.test.mjs"
  },
  "dependencies": {
    "@komerce-design/react": "workspace:*",
    "@komerce-design/tokens": "workspace:*",
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "6.0.3",
    "vite": "5.4.21"
  }
}
