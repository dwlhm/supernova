# ==============================================================================
# Komerce Design System Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Configuration (Antigravity CLI or OpenAI-compatible)
# ------------------------------------------------------------------------------

# Option 1: Antigravity CLI (Recommended — uses local `agy` session, 0 external API keys)
LLM_PROVIDER=agy
LLM_MODEL=gemini-4-argon-medium
LLM_TIMEOUT=180s

# Option 2: OpenCode Go / LongCat (Cloud)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=longcat-2.5-preview-free
# LLM_TIMEOUT=180s
# OPENCODE_SESSION=komerce-design

# Option 3: Local Ollama
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2
# LLM_TIMEOUT=180s

# Option 4: OpenAI / OpenRouter
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Dev / Debug Mode (Optional)
# Set to "true" to use fast deterministic mock authoring (0 token cost, 0 latency)
# ------------------------------------------------------------------------------
# KOMERCE_DEV_MOCK_LLM=true

# ------------------------------------------------------------------------------
# HTTP Listener / Server Configuration (Optional)
# Note: `pnpm komerce sync`, `pnpm komerce regen`, and `pnpm komerce listen`
# run locally without requiring API_TOKEN or GitHub credentials.
# ------------------------------------------------------------------------------
PORT=8080
API_TOKEN=
# KOMERCE_INSECURE_NO_AUTH=true

# ------------------------------------------------------------------------------
# Optional Remote GitHub PR Publisher & Webhook (CI / Bot Mode Only)
# Not needed for the default local-first workflow (GitLab / GitHub / local git).
# ------------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main
GITHUB_WEBHOOK_SECRET=
