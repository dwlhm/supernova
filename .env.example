# ==============================================================================
# Supernova Environment Variables
# ==============================================================================

# Server Port
PORT=8080

# Bearer Token for the Backend API (required). Paste the same value into the Figma plugin.
# Generate one with: openssl rand -hex 32
API_TOKEN=

# Local development only: run without auth. The server refuses to start with an empty
# API_TOKEN unless this is exactly "true".
# SUPERNOVA_INSECURE_NO_AUTH=true

# ------------------------------------------------------------------------------
# LLM Configuration (Antigravity CLI or OpenAI-compatible)
# ------------------------------------------------------------------------------

# Option 1: Antigravity CLI (Recommended — uses local `agy` session, 0 external API keys)
LLM_PROVIDER=agy
LLM_MODEL=gemini-4-argon-medium
LLM_TIMEOUT=180s

# Option 2: OpenCode Go / LongCat (Cloud)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=longcat-2.5-preview-free
# LLM_TIMEOUT=180s
# OPENCODE_SESSION=supernova

# Option 2: Local Ollama (Default)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2
# LLM_TIMEOUT=180s
# Other recommended Ollama models: qwen2.5-coder, mistral, deepseek-r1:8b

# Option 3: OpenAI Cloud (Uncomment to use)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Option 4: OpenRouter (Uncomment to use)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=anthropic/claude-3.5-sonnet

# ------------------------------------------------------------------------------
# GitHub Publisher & Webhook Configuration (Optional)
# Required for GitHub PR publishing and /supernova regenerate review bot loop.
# The webhook endpoint is disabled (503) until GITHUB_WEBHOOK_SECRET is set; only
# OWNER/MEMBER/COLLABORATOR comments on GITHUB_REPO can trigger regeneration.
# ------------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main
GITHUB_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Dev / Debug Mode (Optional)
# Set to "true" to use fast deterministic mock authoring (0 token cost, 0 latency)
# ------------------------------------------------------------------------------
# SUPERNOVA_DEV_MOCK_LLM=true
