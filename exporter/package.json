{
  "name": "@dwlhm/supernova-exporter-mitosis",
  "version": "1.0.0",
  "description": "Export your design system tokens and components into universal Mitosis JS (.lite.tsx) components and theme tokens",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup && node scripts/validate-package.js",
    "dev": "tsup --watch",
    "mock": "node mock/runner.js",
    "mock:watch": "node mock/runner.js --watch",
    "mock:dark": "node mock/runner.js --theme theme-dark",
    "test": "node mock/test.js"
  },
  "keywords": [
    "supernova",
    "exporter",
    "mitosis",
    "design-tokens",
    "components",
    "builder.io"
  ],
  "author": "dwlhm",
  "license": "MIT",
  "peerDependencies": {
    "@supernovaio/sdk-exporters": "^2.3.3"
  },
  "devDependencies": {
    "@supernovaio/sdk-exporters": "^2.3.3",
    "@types/node": "^20.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
